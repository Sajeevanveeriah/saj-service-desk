NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://saj_service_desk:local-development-only@127.0.0.1:5432/saj_service_desk
TEST_DATABASE_URL=postgresql://saj_service_desk:local-development-only@127.0.0.1:5432/saj_service_desk_test
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
ALLOW_INSECURE_LOCAL_PRODUCTION=false
OWNER_BOOTSTRAP_TOKEN=replace-with-a-single-use-random-token
ATTACHMENT_STORAGE=local
LOCAL_ATTACHMENT_ROOT=runtime/attachments
MAX_UPLOAD_BYTES=10485760
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Saj Service Desk <no-reply@localhost>
LIVE_EMAIL_ENABLED=false
PAYPAL_MODE=link
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=
S3_ENDPOINT=
S3_REGION=ap-southeast-2
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
